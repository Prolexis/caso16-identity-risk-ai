    {"name": "Manejo de resultado", "type": "n8n-nodes-base.if", "parameters": {"conditions": {"boolean": [{"value1": "={{$json.status}}", "operation": "notEqual", "value2": "error"}]}}}
  ],
  "connections": {},
  "settings": {"executionOrder": "v1"},
  "tags": ["caso16", "deterministic", "demo"]
}
