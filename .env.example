# Local: copiar a .env; nunca publicar secretos reales.
ENV=development
DATABASE_URL=sqlite:///./data/caso16.db
POSTGRES_PASSWORD=change-me-postgres-password
CASO16_SECRET_KEY=change-me-use-a-random-secret-of-at-least-32-characters
CASO16_API_URL=http://127.0.0.1:8000/api/v1
CASO16_LLM_MODE=deterministic
LANGFLOW_URL=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=3
LANGFLOW_RETRIES=1
# Docker: POSTGRES_PASSWORD y CASO16_SECRET_KEY son obligatorios.
# Producción rechaza claves demo y usuarios que mantengan contraseña demo.
